# Copy to .env (repo root) and fill in real values.
# .env is gitignored — never commit real credentials.

# MongoDB Atlas connection string, e.g.
# mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGO_URL=""

# Database name inside that cluster
DB_NAME="saathi"

# Comma-separated list of allowed origins, or * for any.
# In production set this to your Render static site URL, e.g.
# https://saathi-web.onrender.com
CORS_ORIGINS="*"

# Long random string. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=""

# Password given to the three seeded demo counsellor accounts on first boot.
# There is no default on purpose — the app refuses to seed without it.
SEED_PASSWORD=""

# Email that owns the seeded cases (the primary demo login).
SEED_OWNER_EMAIL="counsellor@saathi.org"
